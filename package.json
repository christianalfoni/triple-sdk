{
  "name": "triple",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter triple-sdk smoke",
    "invariant": "pnpm --filter triple-sdk invariant",
    "bench": "pnpm --filter triple-sdk bench",
    "hooks": "pnpm --filter triple-sdk hooks",
    "dev": "pnpm --filter triple-sdk dev",
    "service:dev": "pnpm --filter worker dev",
    "service:smoke": "pnpm --filter worker smoke",
    "app:dev": "pnpm --filter app dev",
    "app:build": "pnpm --filter app build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
