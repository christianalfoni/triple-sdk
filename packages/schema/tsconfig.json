{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src"]
}
