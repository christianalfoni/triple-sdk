# Local dev: DEV_AUTH=1 (keyless bypass). This file documents the variables;
# the real .dev.vars is gitignored. For real auth locally, set DEV_AUTH=0 and
# fill in the WorkOS credentials. Production never uses this file — it uses
# `wrangler secret put` for the WorkOS values and has no DEV_AUTH at all.
DEV_AUTH=1
#WORKOS_CLIENT_ID=client_...        the application's client id (Applications page)
#WORKOS_API_KEY=sk_...              the environment's secret key (API Keys page) — same environment as the client id
#WORKOS_CLIENT_SECRET=...           only if the Applications page shows a separate client secret for the app
#WORKOS_AUTHKIT_DOMAIN=https://....authkit.app   the AuthKit domain — the OAuth server for MCP clients (claude.ai)
OPERATOR_KEY=dev-only-change-me   opens the operator plane (pnpm ops) — root over every workspace; a real secret in production
