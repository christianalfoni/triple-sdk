# Local dev: DEV_AUTH=1 (keyless bypass). This file documents the variables;
# the real .dev.vars is gitignored. For real auth locally, set DEV_AUTH=0 and
# fill in the WorkOS credentials. Production never uses this file — it uses
# `wrangler secret put` for the two WorkOS values and has no DEV_AUTH at all.
DEV_AUTH=1
#WORKOS_CLIENT_ID=client_...
#WORKOS_API_KEY=sk_...
